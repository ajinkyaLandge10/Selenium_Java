<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="TestNG Regression Suite" verbose="2" thread-count="3" parallel="tests">

	<test name="Flipkart Test">
		<parameter name="url" value="https://www.flipkart.com/"></parameter>
		<parameter name="browser" value="chrome"></parameter>
		<classes>
			<class name="myTests.FlipkartTest" />
		</classes>	
	</test> <!--Test -->
	
	<test name="Google Test">
		<parameter name="url" value="https://www.google.com/"></parameter>
		<parameter name="browser" value="firefox"></parameter>
		<classes>
			<class name="myTests.GoogleTest" />
		</classes>	
	</test> <!--Test -->
	
	<test name="Opencart Test">
		<parameter name="url" value="https://naveenautomationlabs.com/opencart/index.php?route=common/home"></parameter>
		<parameter name="browser" value="edge"></parameter>
		<classes>
			<class name="myTests.OpenCartTest" />
		</classes>	
	</test> <!--Test -->
	
</suite> <!--Suite -->